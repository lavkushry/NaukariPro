[Unit]
Description=NaukariPro Monday 03:00 IST Digest Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/Resume
Environment=HOME=/home/ubuntu
Environment=WORKSPACE=/home/ubuntu/Resume
ExecStart=/home/ubuntu/Resume/naukariPro monday-digest --send-email
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=default.target
