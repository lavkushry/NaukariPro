[Unit]
Description=NaukariPro Cadence Profile Mutator Engine (Milestone 5 / R5)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/ubuntu/Resume
Environment=HOME=/home/ubuntu
Environment=WORKSPACE=/home/ubuntu/Resume
ExecStart=/home/ubuntu/Resume/naukariPro mutate --auto-bump
StandardOutput=journal
StandardError=journal
TimeoutStartSec=600

[Install]
WantedBy=default.target
