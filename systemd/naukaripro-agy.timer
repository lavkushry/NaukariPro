[Unit]
Description=Run NaukariPro Autonomous Career Agent 4x daily via agy CLI (IST peak hours)
PartOf=naukaripro-agy.service

[Timer]
# 09:15 AM IST - Morning recruiter opening queue
OnCalendar=*-*-* 09:15:00 Asia/Kolkata

# 12:00 PM IST - Mid-day recruiter posting wave
OnCalendar=*-*-* 12:00:00 Asia/Kolkata

# 02:31 PM IST - Block 2 hunt + apply + convert + outreach
OnCalendar=*-*-* 14:31:00 Asia/Kolkata

# 06:00 PM IST - Evening shortlisting review
OnCalendar=*-*-* 18:00:00 Asia/Kolkata

# Catch up if the system was powered down during scheduled time
Persistent=true
# Randomize slightly within 2 minutes to look organic
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
