# naukariPro Environment Configuration
# Copy this file to .env and fill in your credentials

# Naukri Login Credentials
NAUKRI_EMAIL=lav84095@gmail.com
NAUKRI_PASSWORD=your_naukri_password

# LinkedIn Authentication
LINKEDIN_LI_AT=your_linkedin_li_at_cookie

# Google Mail (Gmail SMTP & IMAP for confirmation and outcome harvesting)
GMAIL_APP_PASSWORD=your_gmail_app_password

# Automation Behavior & Limits
HEADLESS=true
DAILY_APPLICATION_LIMIT=20
AUTO_ANSWER_SCREENING=true

# Learning Loop & Contextual Bandit
LEARNING_POLICY_ENABLED=true
LEARNING_ALPHA=0.2
LEARNING_REFIT_INTERVAL_OUTCOMES=50

# Optional SOCKS5/HTTP Proxy (for cloud/datacenter bypass)
# NAUKRI_PROXY=socks5://127.0.0.1:10808
