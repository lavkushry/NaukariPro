# naukariPro Environment Configuration
# Copy to .env and fill real values. NEVER commit .env.

# --- Identity (loaded by naukari_pro.config) ---
CANDIDATE_NAME=Your Name
CANDIDATE_EMAIL=you@example.com
CANDIDATE_PHONE=+91-0000000000
CANDIDATE_LINKEDIN=linkedin.com/in/your-handle
CANDIDATE_GITHUB=github.com/your-handle
CANDIDATE_LOCATION=Hyderabad, India

# --- Portal logins ---
NAUKRI_EMAIL=you@example.com
NAUKRI_PASSWORD=your_naukri_password
LINKEDIN_LI_AT=your_linkedin_li_at_cookie
GMAIL_APP_PASSWORD=your_gmail_app_password

# --- Automation ---
HEADLESS=true
DAILY_APPLICATION_LIMIT=20
AUTO_ANSWER_SCREENING=true
NAUKARI_AUTO_SUBMIT=false
NAUKARI_LLM_MODE=replay_preferred
NAUKARI_LLM_MONTHLY_CAP=25.0

# --- Learning / bandit ---
LEARNING_POLICY_ENABLED=true
LEARNING_ALPHA=0.2
LEARNING_REFIT_INTERVAL_OUTCOMES=50
TOTAL_EXPERIENCE=2.5
CURRENT_CTC=12
EXPECTED_CTC=20
NOTICE_PERIOD=15
MIN_SALARY_LPA=20

# --- AI Gateway (M1) — set only the providers you use ---
AI_GATEWAY_DEFAULT_PROVIDER=groq
AI_PROVIDER_GROQ_API_KEY=
AI_PROVIDER_OPENAI_API_KEY=
AI_PROVIDER_GEMINI_API_KEY=
AI_PROVIDER_ANTHROPIC_API_KEY=
AI_PROVIDER_XAI_API_KEY=
AI_PROVIDER_DEEPSEEK_API_KEY=
AI_PROVIDER_MISTRAL_API_KEY=
AI_PROVIDER_OPENROUTER_API_KEY=
# OpenAI-compatible custom endpoint (vLLM / NanoGPT / etc.)
AI_PROVIDER_COMPAT_BASE_URL=
AI_PROVIDER_COMPAT_API_KEY=
AI_PROVIDER_COMPAT_MODEL=
AI_GATEWAY_DAILY_CAP=5.0
AI_GATEWAY_PAUSED_BUDGET=false
# Per-task override example: AI_GATEWAY_RESUME_TAILOR_PROVIDER=openai
NAUKARI_LLM_MONTHLY_CAP=25
NAUKARI_LLM_MODE=replay_preferred

# Optional SOCKS5/HTTP proxy
# NAUKRI_PROXY=socks5://127.0.0.1:10808
